</owl:Class>

<owl:Class rdf:about="#Jacare">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Cagado">
  <rdfs:subClassOf rdf:resource="#Reptil"/>
</owl:Class>

<owl:Class rdf:about="#Banhado">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#contemVegetacao"/>
      <owl:someValuesFrom rdf:resource="#Vegetacao"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#CorpoDagua">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#Lagoa">
  <rdfs:subClassOf rdf:resource="#CorpoDagua"/>
</owl:Class>

<owl:Class rdf:about="#Canal">
  <rdfs:subClassOf rdf:resource="#CorpoDagua"/>
</owl:Class>

<owl:Class rdf:about="#AreaAlagada">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#EventoTravessia">
  <rdfs:subClassOf rdf:resource="#Evento"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#envolveAnimal"/>
      <owl:allValuesFrom rdf:resource="#Animal"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#FatorVisibilidade">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#FatorProximidadeAgua">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#TrechoCritico">
  <rdfs:subClassOf rdf:resource="#TrechoRodovia"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#TrechoRodovia"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#proximoA"/>
          <owl:someValuesFrom rdf:resource="#Banhado"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#temFatorRisco"/>
          <owl:someValuesFrom rdf:resource="#FatorProximidadeAgua"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

