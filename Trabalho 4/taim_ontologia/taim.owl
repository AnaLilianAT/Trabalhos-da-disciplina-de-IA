  <rdfs:subClassOf rdf:resource="#InfraestruturaViaria"/>
</owl:Class>

<owl:Class rdf:about="#CondicaoClimatica">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#PeriodoDia">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#Estacao">
  <rdfs:subClassOf rdf:resource="#CondicaoAmbiental"/>
</owl:Class>

<owl:Class rdf:about="#Habitat">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Rodovia">
  <rdfs:subClassOf rdf:resource="#InfraestruturaViaria"/>
</owl:Class>

<owl:Class rdf:about="#FatorRisco">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Vegetacao">
  <rdfs:subClassOf rdf:resource="#Habitat"/>
</owl:Class>

<owl:Class rdf:about="#EventoAtropelamento">
  <rdfs:subClassOf rdf:resource="#Evento"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#envolveAnimal"/>
      <owl:onClass rdf:resource="#Animal"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#ocorreEmTrecho"/>
      <owl:onClass rdf:resource="#TrechoRodovia"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#FatorTrafego">
  <rdfs:subClassOf rdf:resource="#FatorRisco"/>
</owl:Class>

<owl:Class rdf:about="#InfraestruturaViaria">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CondicaoAmbiental">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

